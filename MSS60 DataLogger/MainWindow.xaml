<Window x:Class="MSS60_DataLogger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MSS60_DataLogger.Controls"
        xmlns:local="clr-namespace:MSS60_DataLogger"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="MSS60 DataLogger" Height="680" Width="1100"
        MinHeight="460" MinWidth="820"
        Background="{StaticResource WindowBackground}"
        FontFamily="Yu Gothic UI">
    <Window.Resources>
        <!-- カテゴリ内の項目 1 件分(☆ボタン+チェックボックス)。名前付き・無名どちらの区画でも、
             「お気に入り」タブでも共通で使う。 -->
        <DataTemplate x:Key="MeasurementItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Button Click="OnFavoriteToggleClick" Background="Transparent" BorderThickness="0"
                        Padding="2" Margin="0,0,4,0" Cursor="Hand" ToolTip="お気に入り">
                    <TextBlock FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="☆" />
                                <Setter Property="Foreground" Value="{StaticResource SubtleForegroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Text" Value="★" />
                                        <Setter Property="Foreground" Value="#FFD54F" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <CheckBox IsChecked="{Binding IsSelected}"
                          AutomationProperties.Name="{Binding Definition.Description}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Definition.Description}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="210"
                                   ToolTip="{Binding Definition.TechnicalName}"
                                   ToolTipService.InitialShowDelay="200" />
                        <TextBlock Text="{Binding Definition.Unit}" Margin="6,0,0,0"
                                   Foreground="{StaticResource SubtleForegroundBrush}" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </DataTemplate>

        <!-- 無名の区画: 見出しを出さずそのまま項目を並べる。 -->
        <DataTemplate x:Key="UnlabeledSectionTemplate">
            <ItemsControl ItemsSource="{Binding VisibleItems}" ItemTemplate="{StaticResource MeasurementItemTemplate}" />
        </DataTemplate>

        <!-- 名前付きの区画: 開閉できるプルダウン(入れ子の Expander)として表示する。 -->
        <DataTemplate x:Key="NamedSectionTemplate">
            <Expander IsExpanded="{Binding IsExpanded}" Margin="0,2,0,4"
                      Foreground="{StaticResource SubtleForegroundBrush}" FontSize="11">
                <Expander.Header>
                    <TextBlock Text="{Binding Name}" FontStyle="Italic" />
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding VisibleItems}" Margin="10,2,0,0"
                              ItemTemplate="{StaticResource MeasurementItemTemplate}" />
            </Expander>
        </DataTemplate>

        <local:SectionTemplateSelector x:Key="SectionSelector"
                                        NamedTemplate="{StaticResource NamedSectionTemplate}"
                                        UnlabeledTemplate="{StaticResource UnlabeledSectionTemplate}" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 上部ツールバー -->
        <Border Grid.Row="0" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1"
                CornerRadius="4" Padding="10,7">
            <DockPanel LastChildFill="False">
                <TextBlock Text="MSS60 DataLogger" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,20,0" />

                <TextBlock Text="COM ポート" Foreground="{StaticResource SubtleForegroundBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="ComPortCombo" MinWidth="110" VerticalAlignment="Center" />
                <Button x:Name="RefreshPortsButton" Content="更新" Margin="6,0,0,0"
                        Click="OnRefreshPortsClick" />

                <Button x:Name="ConnectButton" Content="接続" Margin="14,0,0,0" MinWidth="80"
                        Click="OnConnectClick" />

                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="未接続"
                           Foreground="{StaticResource SubtleForegroundBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- 本体: 左に数値リスト、右にグラフ -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1"
                        Padding="0">
                <TabItem Header="表示">
                <DataGrid x:Name="ValueGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="Transparent" RowBackground="Transparent"
                          AlternatingRowBackground="#FF232323" BorderThickness="0"
                          HorizontalGridLinesBrush="#FF2D2D2D"
                          Foreground="{StaticResource ForegroundBrush}"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          SelectionMode="Single" FontSize="13" RowHeight="26">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="primitives:DataGridColumnHeader">
                            <Setter Property="Background" Value="#FF262626" />
                            <Setter Property="Foreground" Value="{StaticResource SubtleForegroundBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderColorBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Padding" Value="8,5" />
                            <Setter Property="FontFamily" Value="Yu Gothic UI" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="項目" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="6,0">
                                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5"
                                                   Fill="{Binding SeriesBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ToolTipText}"
                                                   ToolTipService.InitialShowDelay="200" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="値" Binding="{Binding FormattedValue}" Width="78">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Margin" Value="0,0,6,0" />
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="単位" Binding="{Binding Unit}" Width="62">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="4,0,0,0" />
                                    <Setter Property="Foreground" Value="{StaticResource SubtleForegroundBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </TabItem>

                <TabItem Header="項目">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
                            <TextBlock x:Name="SelectionCountText" DockPanel.Dock="Right"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{StaticResource SubtleForegroundBrush}" />
                            <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged"
                                     Background="#FF2A2A2A" Foreground="{StaticResource ForegroundBrush}"
                                     BorderBrush="{StaticResource BorderColorBrush}" CaretBrush="White"
                                     ToolTip="項目名・短縮名で絞り込みます" />
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CategoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 全解除ボタンは Expander の外(右隣)に独立して置く。
                                             ヘッダーの中に置くと見出しの折りたたみトグルとクリック領域が重なり、
                                             ボタンが無効化された瞬間にクリックがトグルへ突き抜けてしまうため。 -->
                                        <Grid Margin="0,0,0,2"
                                              Visibility="{Binding IsVisible,
                                                           Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Expander Grid.Column="0" IsExpanded="{Binding IsExpanded}"
                                                      Foreground="{StaticResource ForegroundBrush}">
                                                <Expander.Header>
                                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource ForegroundBrush}" />
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{Binding VisibleSections}" Margin="18,2,0,6"
                                                              ItemTemplateSelector="{StaticResource SectionSelector}" />
                                            </Expander>

                                            <Button Grid.Column="1" Content="全解除"
                                                    IsEnabled="{Binding HasAnySelected}"
                                                    Click="OnCategoryClearAllClick"
                                                    Padding="6,0" Margin="6,0,0,0"
                                                    VerticalAlignment="Top" HorizontalAlignment="Right"
                                                    ToolTip="カテゴリ内で選択中の項目を一斉解除します" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="お気に入り">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                            <Button DockPanel.Dock="Right" Content="選択中をすべて解除"
                                    Click="OnFavoritesClearSelectionClick" />
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <TextBlock x:Name="FavoritesEmptyText" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubtleForegroundBrush}"
                                       Text="お気に入りはまだありません。「項目」タブで各行の☆をクリックすると、ここに追加されます。" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="FavoritesList" ItemTemplate="{StaticResource MeasurementItemTemplate}" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <Border Grid.Column="2" Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="4"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                        <TextBlock Text="グラフ" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="表示時間" VerticalAlignment="Center"
                                       Foreground="{StaticResource SubtleForegroundBrush}" Margin="0,0,6,0" />
                            <TextBox x:Name="WindowSecondsBox" Width="52" VerticalAlignment="Center"
                                     TextAlignment="Right" Text="60"
                                     Background="#FF2A2A2A" Foreground="{StaticResource ForegroundBrush}"
                                     BorderBrush="{StaticResource BorderColorBrush}" CaretBrush="White"
                                     PreviewTextInput="OnWindowSecondsPreviewTextInput"
                                     KeyDown="OnWindowSecondsKeyDown" LostFocus="OnWindowSecondsLostFocus" />
                            <TextBlock Text="秒" VerticalAlignment="Center"
                                       Foreground="{StaticResource SubtleForegroundBrush}" Margin="4,0,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <controls:LiveChart x:Name="Chart" Grid.Row="1" ClipToBounds="True" />

                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="0,6,0,0"
                            BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="表示する線" Foreground="{StaticResource SubtleForegroundBrush}"
                                       Margin="0,0,0,4" />
                            <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="SeriesToggleList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsVisible}" Margin="0,2,14,2"
                                                      Checked="OnSeriesVisibilityChanged"
                                                      Unchecked="OnSeriesVisibilityChanged">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                                               Fill="{Binding Brush}" Margin="2,0,5,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 下部ステータスバー -->
        <Border Grid.Row="2" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1"
                CornerRadius="4" Padding="10,7">
            <DockPanel LastChildFill="False">
                <Button x:Name="RecordButton" Content="● 記録開始" MinWidth="110"
                        Click="OnRecordClick" IsEnabled="False" />
                <TextBlock x:Name="RateText" Text="— Hz" Margin="16,0,0,0" VerticalAlignment="Center"
                           FontFamily="Consolas" Foreground="{StaticResource SubtleForegroundBrush}" />
                <TextBlock x:Name="RowCountText" Text="" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource SubtleForegroundBrush}" />
                <TextBlock x:Name="LogFileText" DockPanel.Dock="Right" Text="" VerticalAlignment="Center"
                           Foreground="{StaticResource SubtleForegroundBrush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="380" Margin="0,0,16,0" />
                <TextBlock x:Name="IdentityText" DockPanel.Dock="Right" Text="VIN: —  SW: —"
                           VerticalAlignment="Center"
                           FontFamily="Consolas" Foreground="{StaticResource SubtleForegroundBrush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="320"
                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
