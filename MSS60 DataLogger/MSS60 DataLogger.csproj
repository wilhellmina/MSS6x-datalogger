<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <RootNamespace>MSS60_DataLogger</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- EdInterfaceObd がシリアルポート(K+DCAN 等)を使うため必要。
         RuntimeIdentifier を明示しないと System.IO.Ports の実装 DLL ではなく
         プラットフォーム非依存のスタブが解決され、実行時に PlatformNotSupportedException になる。 -->
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="EdiabasLib">
      <HintPath>include\EdiabasLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 測定値カタログ(516項目)。exe に埋め込むので配布時に付随ファイルが不要。 -->
    <EmbeddedResource Include="Resources\Messwerte.csv" />
  </ItemGroup>

</Project>
